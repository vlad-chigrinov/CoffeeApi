@* A square picture of a drink or topping; a cup placeholder stands in when there is no picture. *@
@if (string.IsNullOrWhiteSpace(ImageUrl))
{
    <div class="thumb thumb-empty @Class" style="@SizeStyle" role="img" aria-label="@Alt">☕</div>
}
else
{
    <img class="thumb @Class" style="@SizeStyle" src="@ImageUrl" alt="@Alt" loading="lazy" />
}

@code {
    [Parameter] public string? ImageUrl { get; set; }

    [Parameter] public string? Alt { get; set; }

    /// <summary>Side length in pixels; when not set the picture fills its container (CSS decides).</summary>
    [Parameter] public int? Size { get; set; }

    [Parameter] public string? Class { get; set; }

    private string? SizeStyle => Size is { } size ? $"width: {size}px; height: {size}px;" : null;
}
