# Copy to .env and fill in. .env is git-ignored.

# Admin key for the API and the admin panel login (X-Admin-Key). Use a long random value.
ADMIN_API_KEY=

# PrimeUI license key for the admin panel. The admin container reads it at start (not baked into the image).
PRIMEUI_LICENSE=
# Only for `npm run dev` (Vite reads this file); put the same key here.
VITE_PRIMEUI_LICENSE=

# Fill an empty database with a demo catalog (drinks, toppings, ingredients) on the first start.
# Set to false to start with nothing. It never touches a database that already has data.
SEED_DEMO_DATA=true

# Tenant credentials for the tenant app. If SEED_DEMO_DATA is true and the database is empty, the API creates
# this tenant itself on the first start (with a stocked warehouse and demo orders), so pick any name and a long
# random key (e.g. cof_<random>) and fill both in before the first `docker compose up -d`.
# Otherwise (database already has data, or seeding is off) create the tenant in the admin panel first, then
# copy its name and key here and run `docker compose up -d` again (the tenant container won't start until set).
TENANT_NAME=
TENANT_KEY=

# Existing Traefik setup: external docker network, entrypoint and certificate resolver names.
TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
