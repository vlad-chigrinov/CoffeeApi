# Copy to .env and fill in. .env is git-ignored.

# Admin key for the API and the admin panel login (X-Admin-Key). Use a long random value.
ADMIN_API_KEY=

# Tenant credentials for the tenant app. Create the tenant in the admin panel first, then fill these in
# and run `docker compose up -d` again (the tenant container won't start until they are set).
TENANT_NAME=
TENANT_KEY=

# Existing Traefik setup: external docker network, entrypoint and certificate resolver names.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
